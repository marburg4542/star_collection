# คัดลอกเป็น .env แล้วแก้ตามเครื่อง (ไม่มีไฟล์นี้ก็ใช้ค่าด้านล่างเป็นค่าเริ่มต้น)

# พอร์ตของแอป — ร้าน online_shop ใช้ 5000 อยู่แล้ว (ถ้าเปลี่ยน ต้องแก้ proxy ใน vite.config.js ด้วย)
API_PORT=5100

# 127.0.0.1 = รับเฉพาะในเครื่อง (Cloudflare tunnel ต่อเข้ามาทางนี้) · 0.0.0.0 = เปิดให้เครื่องอื่นในวง LAN เข้าได้
HOST=127.0.0.1

# ที่อยู่ไฟล์ฐานข้อมูล (นับจากโฟลเดอร์ server/) — ไฟล์สำรองรายวันจะอยู่ใน backups/ ข้างๆ
DB_PATH=data/stars.sqlite

# ที่อยู่เว็บจริง ใช้เป็นผู้ส่งแจ้งเตือน (VAPID subject)
APP_URL=https://stars.personal-proj.site
